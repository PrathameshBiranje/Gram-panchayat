rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles collection
    match /users/{userId} {
      allow read, create, update: if true;
    }

    // Citizen grievances collection
    match /grievances/{grievanceId} {
      allow read, create, update, delete: if true;
    }

    // Citizen feedback collection
    match /feedbacks/{feedbackId} {
      allow read, create, update, delete: if true;
    }

    // PDO direct messages / queries
    match /pdo_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Sakala applications collection
    match /sakala_applications/{appId} {
      allow read, create, update, delete: if true;
    }
  }
}

